{
  "dependencies": {
    "@echelon-foundry/design-system": "https://github.com/kemiller2002/forma/releases/download/v0.2.0/echelon-foundry-design-system-0.2.0.tgz",
    "@echelon-foundry/print-components": "https://github.com/kemiller2002/folio/archive/273b18f5b23db15cddd173c05af5d1a8484fc4cf.tar.gz",
    "@echelon-foundry/typescript-wasm-kernel": "0.6.2"
  },
  "name": "vigila",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "dotnet publish src/Vigila.Wasm/Vigila.Wasm.csproj -c Release",
    "check:limen": "npx limen verify --strict",
    "check:architecture": "./scripts/check-architecture.sh",
    "test:dotnet": "dotnet test Vigila.sln -c Release",
    "test": "npm run check:architecture && npm run check:limen && npm run test:dotnet && npm run test:browser",
    "serve": "python3 -m http.server 4321",
    "start": "npm run build:wasm && npm run serve",
    "test:browser": "npm run build:wasm && npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
